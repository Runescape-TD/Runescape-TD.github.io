export default "#version 300 es\r\n\r\n#ifdef MULTI_DRAW\r\n\r\n    #extension GL_ANGLE_multi_draw : require\r\n    #define DRAW_ID gl_DrawID\r\n\r\n#else\r\n\r\n    #define DRAW_ID u_drawId\r\n\r\n    uniform int u_drawId;\r\n\r\n#endif\r\n\r\n\r\n#define TEXTURE_ANIM_UNIT (1.0f / 128.0f)\r\n\r\n// TAU / 2048.0\r\n#define RS_TO_RADIANS 0.00306796157\r\n\r\n#define FOG_CORNER_ROUNDING 8.0\r\n\r\n#define ACTOR_DATA_WIDTH 512\r\n\r\nprecision highp float;\r\n\r\nlayout(std140, column_major) uniform;\r\n\r\nuniform highp isampler2D u_textureMaterials;\r\n\r\n// Per frame\r\nuniform SceneUniforms {\r\n    mat4 u_viewProjMatrix;\r\n    mat4 u_viewMatrix;\r\n    mat4 u_projectionMatrix;\r\n    vec4 u_skyColor;\r\n    vec2 u_cameraPos;\r\n    float u_renderDistance;\r\n    float u_fogDepth;\r\n    float u_currentTime;\r\n    float u_brightness;\r\n    float u_colorBanding;\r\n    float u_isNewTextureAnim;\r\n    // World tiles (x0, y0, x1, y1) to keep clear: the world fades into the sky past them\r\n    vec4 u_playArea;\r\n    // Multiplied over what main.frag draws (a raid hall's colour wash): white changes nothing\r\n    vec4 u_wash;\r\n    // Lights (MapDef.lighting, includes/lights.glsl), read only by a lit map's programs (their\r\n    // LIGHTS): the ambient's colour times how bright it is; and where u_lightMap is, world tiles\r\n    // x and z of its corner and one over its size in tiles\r\n    vec4 u_ambient;\r\n    vec4 u_lightMapArea;\r\n};\r\n\r\n\r\n// First instance of this draw call in the actor data texture\r\nuniform int u_instanceOffset;\r\n\r\n// 4 texels per instance:\r\n//  0: world x (tiles), world y (tiles, up is negative), world z (tiles), yaw (0-2047)\r\n//  1: scale, flash (0-1, or -1-0 to glow in the tint's colour), tint (0xRRGGBB, 0xFFFFFF = none),\r\n//     alpha\r\n//  2: edge light (0-1), how far in it reaches (0-1 of the way to the middle), its colour\r\n//     (0xRRGGBB), and how much it's drawn at full brightness whatever the light (0-1, lights.glsl)\r\n//  3: stretch along x and z, tip about x and z (0-2047), before the yaw\r\nuniform highp sampler2D u_actorData;\r\n\r\nlayout(location = 0) in uvec3 a_vertex;\r\n\r\nout vec4 v_color;\r\nout vec2 v_texCoord;\r\nflat out uint v_texId;\r\nflat out float v_alphaCutOff;\r\nout float v_fogAmount;\r\nflat out vec4 v_interactId;\r\n#ifdef LIGHTS\r\n// World tiles x and z, and how much it's drawn as if it were lit (lights.glsl)\r\nout vec3 v_lightPos;\r\n#endif\r\n// Edge light (ActorDrawOptions.edge): where in the model this is, -1 to 1 across a tile, and the\r\n// light's colour and strength, and how far in it reaches\r\nout vec2 v_edgePos;\r\nflat out vec4 v_edge;\r\nflat out float v_edgeWidth;\r\nflat out vec2 v_edgeStretch;\r\n\r\n// https://theorangeduck.com/page/avoiding-shader-conditionals\r\n\r\n// ==\r\nfloat when_eq(float x, float y) {\r\n    return 1.0 - abs(sign(x - y));\r\n}\r\n\r\n// !=\r\nfloat when_neq(float x, float y) {\r\n    return abs(sign(x - y));\r\n}\r\n\r\n// >\r\nfloat when_gt(float x, float y) {\r\n    return max(sign(x - y), 0.0);\r\n}\r\n\r\n// <\r\nfloat when_lt(float x, float y) {\r\n    return max(sign(y - x), 0.0);\r\n}\r\n\r\n// >=\r\nfloat when_ge(float x, float y) {\r\n    return 1.0 - when_lt(x, y);\r\n}\r\n\r\n// <=\r\nfloat when_le(float x, float y) {\r\n    return 1.0 - when_gt(x, y);\r\n}\r\n\r\n// &&\r\nfloat and(float a, float b) {\r\n    return a * b;\r\n}\r\n\r\n// ||\r\nfloat or(float a, float b) {\r\n    return min(a + b, 1.0);\r\n}\r\n\r\n// ^\r\nfloat xor(float a, float b) {\r\n    return mod(a + b, 2.0);\r\n}\r\n\r\n// https://stackoverflow.com/a/17309861\r\nvec3 hslToRgb(int hsl, float brightness) {\r\n    const float onethird = 1.0 / 3.0;\r\n    const float twothird = 2.0 / 3.0;\r\n    const float rcpsixth = 6.0;\r\n\r\n    float hue = float(hsl >> 10) / 64.0 + 0.0078125;\r\n    float sat = float((hsl >> 7) & 0x7) / 8.0 + 0.0625;\r\n    float lum = float(hsl & 0x7f) / 128.0;\r\n\r\n    vec3 xt = vec3(\r\n        rcpsixth * (hue - twothird),\r\n        0.0,\r\n        rcpsixth * (1.0 - hue)\r\n    );\r\n\r\n    xt = mix(xt, vec3(\r\n        0.0,\r\n        rcpsixth * (twothird - hue),\r\n        rcpsixth * (hue - onethird)\r\n    ), when_lt(hue, twothird));\r\n\r\n    xt = mix(xt, vec3(\r\n        rcpsixth * (onethird - hue),\r\n        rcpsixth * hue,\r\n        0.0\r\n    ), when_lt(hue, onethird));\r\n\r\n    // if (hue < twothird) {\r\n    //     xt.r = 0.0;\r\n    //     xt.g = rcpsixth * (twothird - hue);\r\n    //     xt.b = rcpsixth * (hue      - onethird);\r\n    // }\r\n\r\n    // if (hue < onethird) {\r\n    //     xt.r = rcpsixth * (onethird - hue);\r\n    //     xt.g = rcpsixth * hue;\r\n    //     xt.b = 0.0;\r\n    // }\r\n\r\n    xt = min( xt, 1.0 );\r\n\r\n    float sat2   =  2.0 * sat;\r\n    float satinv =  1.0 - sat;\r\n    float luminv =  1.0 - lum;\r\n    float lum2m1 = (2.0 * lum) - 1.0;\r\n    vec3  ct     = (sat2 * xt) + satinv;\r\n\r\n    // vec3 rgb;\r\n    // if (lum >= 0.5)\r\n    //      rgb = (luminv * ct) + lum2m1;\r\n    // else rgb =  lum    * ct;\r\n\r\n    vec3 rgb = mix((luminv * ct) + lum2m1, lum * ct, when_lt(lum, 0.5));\r\n\r\n    return pow(rgb, vec3(brightness));\r\n}\r\n\r\nfloat unpackFloat16(int v) {\r\n    int exponent = v >> 10;\r\n    float mantissa = float(v & 0x3FF) / 1024.0;\r\n    return float(exponent) + mantissa;\r\n}\r\n\r\nfloat unpackFloat12(uint v) {\r\n    return 16.0 - float(v) / 128.0;\r\n}\r\n\r\nfloat unpackFloat11(uint v) {\r\n    return 16.0 - float(v) / 64.0;\r\n}\r\n\r\nfloat unpackFloat11(int v) {\r\n    return 16.0 - float(v) / 64.0;\r\n}\r\n\r\nfloat unpackFloat6(uint v) {\r\n    return float(v) / 63.0;\r\n}\r\n\r\nfloat unpackFloat6(int v) {\r\n    return float(v) / 63.0;\r\n}\r\n\r\nfloat fogFactorLinear(float dist, float start, float end) {\r\n    return 1.0 - clamp((dist - start) / (end - start), 0.0, 1.0);\r\n}\r\n\r\nfloat sdRoundedBox(vec2 p, vec2 b, float r) {\r\n    vec2 q = abs(p) - b + r;\r\n    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;\r\n}\r\n\r\n// World tiles past the play area's edge over which the world fades out\r\n#define PLAY_AREA_FADE 6.0\r\n\r\n// How far a point (world tiles) has faded past the edge of the play area\r\nfloat playAreaFog(vec2 pos) {\r\n    vec2 centre = (u_playArea.xy + u_playArea.zw) * 0.5;\r\n    vec2 halfSize = (u_playArea.zw - u_playArea.xy) * 0.5;\r\n    return clamp(sdRoundedBox(pos - centre, halfSize, 0.0) / PLAY_AREA_FADE, 0.0, 1.0);\r\n}\r\n\r\n\r\nstruct Material {\r\n    int animU;\r\n    int animV;\r\n    float alphaCutOff;\r\n};\r\n\r\nMaterial getMaterial(uint textureId) {\r\n    ivec4 data = texelFetch(u_textureMaterials, ivec2(textureId, 0), 0);\r\n\r\n    Material material;\r\n    material.animU = data.r;\r\n    material.animV = data.g;\r\n    material.alphaCutOff = float(data.b & 0xFF) / 255.0;\r\n\r\n    return material;\r\n}\r\n\r\n\r\nstruct Vertex {\r\n    vec3 pos;\r\n    vec4 color;\r\n    vec2 texCoord;\r\n    uint textureId;\r\n    uint priority;\r\n};\r\n\r\nVertex decodeVertex(uint v0, uint v1, uint v2, float brightness) {\r\n    float x = float(int((v0 >> 17u) & 0x7FFFu) - 0x4000);\r\n    float u = unpackFloat11(((v0 >> 11u) & 0x3Fu) | ((v2 & 0x1Fu) << 6u));\r\n    float v = unpackFloat11(v0 & 0x7FFu);\r\n\r\n    float y = -float(int((v1) & 0x7FFFu) - 0x4000);\r\n    int hsl = int((v1 >> 15u) & 0xFFFFu);\r\n    float isTextured = float((v1 >> 31) & 0x1u);\r\n    float textureId = float(((hsl >> 7) | int(((v2 >> 5u) & 0x1u) << 9u)) + 1) * isTextured;\r\n\r\n    float z = float(int((v2 >> 17u) & 0x7FFFu) - 0x4000);\r\n    float alpha = float((v2 >> 9u) & 0xFFu) / 255.0;\r\n    uint priority = ((v2 >> 6u) & 0x7u);\r\n\r\n    vec4 color = when_eq(textureId, 0.0) * vec4(hslToRgb(hsl, brightness), alpha)\r\n        + when_neq(textureId, 0.0) * vec4(vec3(float(hsl & 0x7F) / 127.0), alpha);\r\n\r\n    return Vertex(vec3(x, y, z), color, vec2(u, v), uint(textureId), priority);\r\n}\r\n\r\n\r\nvec4 fetchActorData(int index) {\r\n    return texelFetch(u_actorData, ivec2(index % ACTOR_DATA_WIDTH, index / ACTOR_DATA_WIDTH), 0);\r\n}\r\n\r\nmat4 rotationY( in float angle ) {\r\n    return mat4(cos(angle),\t\t0,\t\tsin(angle),\t0,\r\n                         0,\t\t1.0,\t\t\t 0,\t0,\r\n                -sin(angle),\t0,\t\tcos(angle),\t0,\r\n                        0, \t\t0,\t\t\t\t0,\t1);\r\n}\r\n\r\nvoid main() {\r\n    Vertex vertex = decodeVertex(a_vertex.x, a_vertex.y, a_vertex.z, u_brightness);\r\n\r\n    Material material = getMaterial(vertex.textureId);\r\n    vec2 textureAnimation = vec2(material.animU, material.animV);\r\n\r\n    if (u_isNewTextureAnim > 0.5) {\r\n        v_texCoord = vertex.texCoord + mod(mod(u_currentTime, 128.0) * textureAnimation / 64.0, 1.0);\r\n    } else {\r\n        v_texCoord = vertex.texCoord + (u_currentTime / 0.02) * textureAnimation * TEXTURE_ANIM_UNIT;\r\n    }\r\n    v_texId = vertex.textureId;\r\n    v_alphaCutOff = material.alphaCutOff;\r\n\r\n    // Without multi draw, a run of instances of one frame is one instanced draw\r\n    int dataIndex = (DRAW_ID + gl_InstanceID + u_instanceOffset) * 4;\r\n    vec4 data0 = fetchActorData(dataIndex);\r\n    vec4 data1 = fetchActorData(dataIndex + 1);\r\n    vec4 data2 = fetchActorData(dataIndex + 2);\r\n    vec4 data3 = fetchActorData(dataIndex + 3);\r\n\r\n    float scale = data1.x;\r\n    float flash = data1.y;\r\n    int tint = int(data1.z);\r\n    float alpha = data1.w;\r\n\r\n    vec3 tintColor = vec3(float((tint >> 16) & 0xFF), float((tint >> 8) & 0xFF), float(tint & 0xFF)) / 255.0;\r\n    v_color = vertex.color;\r\n    // A flash goes to white; a negative one goes to the tint's own colour, lit or not, so a\r\n    // model can glow (the light under the Wardens' floor, client/FloorView.ts)\r\n    vec3 flashColor = flash < 0.0 ? tintColor : vec3(1.0);\r\n    v_color.rgb = mix(v_color.rgb * tintColor, flashColor, abs(flash));\r\n    v_color.a *= alpha;\r\n\r\n    int edgeColor = int(data2.z);\r\n    v_edge = vec4(\r\n        vec3(float((edgeColor >> 16) & 0xFF), float((edgeColor >> 8) & 0xFF), float(edgeColor & 0xFF)) / 255.0,\r\n        data2.x\r\n    );\r\n    v_edgeWidth = max(data2.y, 0.001);\r\n    v_edgePos = vertex.pos.xz / 64.0;\r\n    v_edgeStretch = data3.xy;\r\n\r\n    vec3 pos = vertex.pos * scale * vec3(data3.x, 1.0, data3.y);\r\n    // Tipped over about x, then z (y is down)\r\n    float pitch = data3.z * RS_TO_RADIANS;\r\n    float roll = data3.w * RS_TO_RADIANS;\r\n    pos = vec3(pos.x, pos.y * cos(pitch) - pos.z * sin(pitch), pos.y * sin(pitch) + pos.z * cos(pitch));\r\n    pos = vec3(pos.x * cos(roll) - pos.y * sin(roll), pos.x * sin(roll) + pos.y * cos(roll), pos.z);\r\n    vec4 localPos = vec4(pos, 1.0) * rotationY(data0.w * RS_TO_RADIANS);\r\n    vec4 worldPos = vec4(localPos.xyz / 128.0 + data0.xyz, 1.0);\r\n\r\n    float dist = -sdRoundedBox(\r\n        vec2(worldPos.x - u_cameraPos.x, worldPos.z - u_cameraPos.y),\r\n        vec2(u_renderDistance),\r\n        FOG_CORNER_ROUNDING\r\n    );\r\n    float fogDepth = min(u_fogDepth, u_renderDistance);\r\n    v_fogAmount = max(fogFactorLinear(dist, 0.0, fogDepth), playAreaFog(worldPos.xz));\r\n\r\n    v_interactId = vec4(0.0);\r\n\r\n#ifdef LIGHTS\r\n    // A flash shows in the dark too, so a hit on something out of the light can be seen\r\n    v_lightPos = vec3(worldPos.xz, max(data2.w, abs(flash)));\r\n#endif\r\n\r\n    gl_Position = u_viewMatrix * worldPos;\r\n    gl_Position.z += (float(vertex.priority) + 20.0) * 0.0007;\r\n    gl_Position = u_projectionMatrix * gl_Position;\r\n}\r\n";