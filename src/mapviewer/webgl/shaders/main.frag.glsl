export default "#version 300 es\r\n\r\nprecision highp float;\r\n\r\nlayout(std140, column_major) uniform;\r\n\r\n// Per frame\r\nuniform SceneUniforms {\r\n    mat4 u_viewProjMatrix;\r\n    mat4 u_viewMatrix;\r\n    mat4 u_projectionMatrix;\r\n    vec4 u_skyColor;\r\n    vec2 u_cameraPos;\r\n    float u_renderDistance;\r\n    float u_fogDepth;\r\n    float u_currentTime;\r\n    float u_brightness;\r\n    float u_colorBanding;\r\n    float u_isNewTextureAnim;\r\n    // World tiles (x0, y0, x1, y1) to keep clear: the world fades into the sky past them\r\n    vec4 u_playArea;\r\n    // Multiplied over what main.frag draws (a raid hall's colour wash): white changes nothing\r\n    vec4 u_wash;\r\n    // Lights (MapDef.lighting, includes/lights.glsl), read only by a lit map's programs (their\r\n    // LIGHTS): the ambient's colour times how bright it is; and where u_lightMap is, world tiles\r\n    // x and z of its corner and one over its size in tiles\r\n    vec4 u_ambient;\r\n    vec4 u_lightMapArea;\r\n};\r\n\r\n#ifdef LIGHTS\r\n// Lights (MapDef.lighting): every pixel is its colour times the ambient's (u_ambient: 1 as the\r\n// map always is, about 0.2 in the dark) and the light where it stands, with a faint haze of the\r\n// light's colour on top. The light is a texture over the ground round the view (u_lightMap, two\r\n// texels a tile, GameWebGLRenderer's light map), which every light's been added into on the CPU,\r\n// so a pixel costs one texture read however many lights there are.\r\n\r\nuniform sampler2D u_lightMap;\r\n\r\n// The light map's texels go up to this (stored over it, 0 to 1)\r\n#define LIGHT_MAP_MAX 2.0\r\n// Of the light's colour, what's added on top as well as multiplied in: a haze that tints even what's\r\n// dark or white\r\n#define LIGHT_HAZE 0.08\r\n\r\n// A colour (rgb) at pos (world tiles x, z), lit. unlit (0 to 1): how much of it's drawn at full\r\n// brightness anyway (a warning, a spell, a hit's flash).\r\nvec3 applyLight(vec3 color, vec2 pos, float unlit) {\r\n    vec3 added = texture(u_lightMap, (pos - u_lightMapArea.xy) * u_lightMapArea.z).rgb * LIGHT_MAP_MAX;\r\n    vec3 light = max(min(u_ambient.rgb + added, vec3(LIGHT_MAP_MAX)), vec3(unlit));\r\n    return color * light + added * LIGHT_HAZE;\r\n}\r\n\r\n#endif\r\n\r\nuniform highp sampler2DArray u_textures;\r\n\r\nin vec4 v_color;\r\nin vec2 v_texCoord;\r\nflat in uint v_texId;\r\nflat in float v_alphaCutOff;\r\nin float v_fogAmount;\r\nflat in vec4 v_interactId;\r\n#ifdef LIGHTS\r\n// World tiles x and z, and how much it's drawn as if it were lit (lights.glsl)\r\nin vec3 v_lightPos;\r\n#endif\r\n#ifdef ACTOR_EDGE\r\nin vec2 v_edgePos;\r\nflat in vec4 v_edge;\r\nflat in float v_edgeWidth;\r\nflat in vec2 v_edgeStretch;\r\n#endif\r\n\r\nlayout(location = 0) out vec4 fragColor;\r\nlayout(location = 1) out vec4 interactId;\r\n\r\nvoid main() {\r\n    vec4 textureColor = texture(u_textures, vec3(v_texCoord, v_texId)).bgra;\r\n    fragColor = pow(textureColor, vec4(vec3(u_brightness), 1.0)) *\r\n        vec4(round(v_color.rgb * u_colorBanding) / u_colorBanding, v_color.a);\r\n#ifdef DISCARD_ALPHA\r\n    if ((v_texId == 0u && fragColor.a < 0.01) || (textureColor.a < v_alphaCutOff)) {\r\n        discard;\r\n    }\r\n#endif\r\n#ifdef LIGHTS\r\n    // Only a lit map's programs have this (GameWebGLRenderer.setLighting)\r\n    fragColor.rgb = applyLight(fragColor.rgb, v_lightPos.xy, v_lightPos.z);\r\n#endif\r\n#ifdef ACTOR_EDGE\r\n    // Light along a tile-sized actor's edges, strongest at the edge and fading in towards the\r\n    // middle (the Wardens' floor's light from under its tiles)\r\n    if (v_edge.a > 0.0) {\r\n        // How far in from its nearest edge, in half tiles (a stretched slab's edge light is as\r\n        // wide as a tile's)\r\n        vec2 fromEdge = (1.0 - abs(v_edgePos)) * v_edgeStretch;\r\n        float light = 1.0 - smoothstep(0.0, v_edgeWidth, min(fromEdge.x, fromEdge.y));\r\n        fragColor.rgb = mix(fragColor.rgb, v_edge.rgb, v_edge.a * light * light);\r\n    }\r\n#endif\r\n    fragColor = mix(fragColor, u_skyColor, v_fogAmount);\r\n    fragColor.rgb *= u_wash.rgb;\r\n    interactId = v_interactId;\r\n}\r\n";